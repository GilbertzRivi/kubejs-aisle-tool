// Turns the structure text the server sends into KubeJS for GTM 8 and puts it on the clipboard.
//
// GTM 8's pattern builder (MultiblockPatternBuilder, exposed to KubeJS as FactoryBlockPattern) takes `.slice(...)`, which replaced
// `.aisle(...)`, and `.where(char, predicate)`. Each slice here is one horizontal-row layer, exactly as the 1.20.1 tool wrote its aisles.

fn mapping_find(keys: &[String], count: Int, key: String) -> Int {
    var idx = 0;
    while idx < count {
        if keys[idx] == key {
            return idx;
        }
        idx = idx + 1;
    }
    return -1;
}

// Escapes a string for a double-quoted JavaScript literal.
pub fn js_escape(s: String) -> String {
    let out = JStringBuilder::new();
    var i = 0;
    while i < s.length() {
        let c = s.substring(i, i + 1);
        if c == "\\" {
            out.append("\\\\");
        } else if c == "\"" {
            out.append("\\\"");
        } else {
            out.append(c);
        }
        i = i + 1;
    }
    return out.toString();
}

fn append_slice(output: &JStringBuilder, encoded: String, size_x: Int, size_z: Int, level_size: Int, y_index: Int) {
    output.append(".slice(");
    let level_start = y_index * level_size;
    var z = 0;
    while z < size_z {
        let row_start = level_start + z * size_x;
        let row = encoded.substring(row_start, row_start + size_x);
        if z > 0 {
            output.append(", ");
        }
        output.append("\"");
        output.append(js_escape(row));
        output.append("\"");
        z = z + 1;
    }
    output.append(")\n");
}

// Returns the KubeJS text, or `data` unchanged when it is not a structure text.
pub fn decode_clipboard(data: String) -> String {
    let lines = (data as JStr).split("\n", -1);
    if lines.length < 2 {
        return data;
    }

    let dims = (lines[0].trim() as JStr).split(" ", 0);
    if dims.length != 3 {
        return data;
    }

    var size_x = 0;
    var size_y = 0;
    var size_z = 0;
    try {
        size_x = JInteger::parseInt(dims[0]);
        size_y = JInteger::parseInt(dims[1]);
        size_z = JInteger::parseInt(dims[2]);
    } catch (e: JNumberFormatException) {
        return data;
    }

    var mapping_keys = [""; 128];
    var mapping_values = [""; 128];
    var mapping_count = 0;
    var i = 1;
    while i < lines.length && lines[i].trim().length() > 0 {
        let line = lines[i].trim();
        let parts = (line as JStr).split("=", 2);
        if parts.length == 2 && parts[0].length() > 0 {
            let key = parts[0].substring(0, 1);
            let existing = mapping_find(&mapping_keys, mapping_count, key);
            if existing >= 0 {
                mapping_values[existing] = parts[1];
            } else if mapping_count < 128 {
                mapping_keys[mapping_count] = key;
                mapping_values[mapping_count] = parts[1];
                mapping_count = mapping_count + 1;
            }
        }
        i = i + 1;
    }
    while i < lines.length && lines[i].trim().length() == 0 {
        i = i + 1;
    }

    let encoded_builder = JStringBuilder::new();
    while i < lines.length {
        encoded_builder.append(lines[i].trim());
        i = i + 1;
    }
    let encoded = encoded_builder.toString();

    if encoded.length() < size_x * size_y * size_z {
        return data;
    }

    let output = JStringBuilder::new();
    let level_size = size_x * size_z;

    var y = size_y - 1;
    while y >= 0 {
        append_slice(&output, encoded, size_x, size_z, level_size, y);
        y = y - 1;
    }

    output.append("\n");

    var m = 0;
    while m < mapping_count {
        output.append(".where(\"");
        output.append(js_escape(mapping_keys[m]));
        output.append("\", Predicates.blocks(\"");
        output.append(js_escape(mapping_values[m]));
        output.append("\"))\n");
        m = m + 1;
    }

    return output.toString();
}

// Client side: decode, then either copy the text or (when it is too long for the clipboard) save it to packet.txt and copy that path.
pub fn set_clipboard(data: String) {
    let text = decode_clipboard(data);
    let mc = Minecraft::getInstance();
    if text.length() > 32767 {
        try {
            let path = JPaths::get("packet.txt", [""; 0]);
            JFiles::writeString(path, text as JCharSequence, [
                JStandardOpenOption::CREATE as JOpenOption,
                JStandardOpenOption::TRUNCATE_EXISTING as JOpenOption,
                JStandardOpenOption::WRITE as JOpenOption
            ]);
            mc.keyboardHandler.setClipboard("Data saved to: " + path.toAbsolutePath().toString());
            let toast = SystemToast::new(
                SystemToastId::PERIODIC_NOTIFICATION,
                Component::literal("Copy Tool") as Component,
                Component::literal("The selection was too big for the clipboard; its file path was copied instead") as Component
            );
            mc.getToasts().addToast(toast as Toast);
        } catch (e: JException) {
            mc.keyboardHandler.setClipboard(text.substring(0, 32767));
        }
    } else {
        mc.keyboardHandler.setClipboard(text);
    }
}
