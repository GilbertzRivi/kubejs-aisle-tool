// Turns the structure text the server sends into KubeJS for GTM 8 and puts it on the clipboard.
//
// GTM 8's pattern builder (MultiblockPatternBuilder, exposed to KubeJS as FactoryBlockPattern) takes `.slice(...)`, which replaced
// `.aisle(...)`, and `.where(char, predicate)`. The server already ordered the blocks the way the builder reads them (see
// `scan_region`), so this only has to letter them and print them.

// The characters blocks are lettered with, in order. Both lists hold the same 91 characters (none is a quote or a backslash).
static LETTERS_LOWER_FIRST: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!#$%&'()*+,-./:;<>?@[]^_`\{|\}~";
static LETTERS_UPPER_FIRST: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&'()*+,-./:;<>?@[]^_`\{|\}~";

// What the controller is written as in the pattern (GTM's own examples use K).
static CONTROLLER_LETTER: String = "K";

// Escapes a string for a double-quoted JavaScript literal.
pub fn js_escape(s: String) -> String {
    let out = JStringBuilder::new();
    var i = 0;
    while i < s.length() {
        let c = s.substring(i, i + 1);
        if c == "\\" {
            out.append("\\\\");
        } else if c == "\"" {
            out.append("\\\"");
        } else {
            out.append(c);
        }
        i = i + 1;
    }
    return out.toString();
}

fn is_air(id: String) -> Bool {
    return id == "minecraft:air" || id == "minecraft:cave_air" || id == "minecraft:void_air";
}

// The PartAbility constants (comma separated, e.g. "IMPORT_ITEMS, IMPORT_FLUIDS") a GTM hatch or bus block provides, judged from its
// id, or "" when the block is not a recognised part. This reads the id only, so an addon part that names itself differently is
// simply written as a plain block.
pub fn part_abilities(id: String) -> String {
    if id.length() <= 6 || id.substring(0, 6) != "gtceu:" {
        return "";
    }
    let path = id.substring(6, id.length());
    if path.contains("substation_input_hatch") { return "SUBSTATION_INPUT_ENERGY"; }
    if path.contains("substation_output_hatch") { return "SUBSTATION_OUTPUT_ENERGY"; }
    if path.contains("laser_target") { return "INPUT_LASER"; }
    if path.contains("laser_source") { return "OUTPUT_LASER"; }
    if path.contains("energy_input_hatch") { return "INPUT_ENERGY"; }
    if path.contains("energy_output_hatch") { return "OUTPUT_ENERGY"; }
    if path.contains("steam_input_bus") { return "STEAM_IMPORT_ITEMS"; }
    if path.contains("steam_output_bus") { return "STEAM_EXPORT_ITEMS"; }
    if path.contains("steam_hatch") { return "STEAM"; }
    if path.contains("dual_input_hatch") { return "IMPORT_ITEMS, IMPORT_FLUIDS"; }
    if path.contains("dual_output_hatch") { return "EXPORT_ITEMS, EXPORT_FLUIDS"; }
    if path.contains("quadruple_input_hatch") { return "IMPORT_FLUIDS_4X"; }
    if path.contains("quadruple_output_hatch") { return "EXPORT_FLUIDS_4X"; }
    if path.contains("nonuple_input_hatch") { return "IMPORT_FLUIDS_9X"; }
    if path.contains("nonuple_output_hatch") { return "EXPORT_FLUIDS_9X"; }
    if path.contains("input_hatch") { return "IMPORT_FLUIDS"; }
    if path.contains("output_hatch") { return "EXPORT_FLUIDS"; }
    if path.contains("input_bus") { return "IMPORT_ITEMS"; }
    if path.contains("output_bus") { return "EXPORT_ITEMS"; }
    if path.contains("maintenance_hatch") { return "MAINTENANCE"; }
    if path.contains("muffler_hatch") { return "MUFFLER"; }
    if path.contains("rotor_holder") { return "ROTOR_HOLDER"; }
    if path.contains("data_access_hatch") { return "DATA_ACCESS"; }
    return "";
}

// "IMPORT_ITEMS, IMPORT_FLUIDS" -> "Predicates.abilities(PartAbility.IMPORT_ITEMS, PartAbility.IMPORT_FLUIDS)"
fn abilities_predicate(abilities: String) -> String {
    let names = (abilities as JStr).split(", ", 0);
    let out = JStringBuilder::new();
    out.append("Predicates.abilities(");
    var i = 0;
    while i < names.length {
        if i > 0 {
            out.append(", ");
        }
        out.append("PartAbility.");
        out.append(names[i]);
        i = i + 1;
    }
    out.append(")");
    return out.toString();
}

fn index_of_key(keys: &[String], count: Int, key: String) -> Int {
    var idx = 0;
    while idx < count {
        if keys[idx] == key {
            return idx;
        }
        idx = idx + 1;
    }
    return -1;
}

// The KubeJS for one selection, in the style the player chose:
//   uppercase_first -- letter blocks A, B, C ... before a, b, c ...
//   air_mode        -- 0: air is a space ("anything"), 1: air gets Predicates.air(), 2: air is a plain block
//   parts           -- write GTM hatches and buses as Predicates.abilities(...)
//   full            -- wrap everything in .pattern(definition => FactoryBlockPattern.start() ... .build())
// Returns `data` unchanged when it is not a structure text.
pub fn decode_clipboard_with(data: String, uppercase_first: Bool, air_mode: Int, parts: Bool, full: Bool) -> String {
    let lines = (data as JStr).split("\n", -1);
    if lines.length < 2 {
        return data;
    }

    let dims = (lines[0].trim() as JStr).split(" ", 0);
    if dims.length != 4 || dims[0] != "v2" {
        return data;
    }

    var slices = 0;
    var rows = 0;
    var chars = 0;
    try {
        slices = JInteger::parseInt(dims[1]);
        rows = JInteger::parseInt(dims[2]);
        chars = JInteger::parseInt(dims[3]);
    } catch (e: JNumberFormatException) {
        return data;
    }

    // the table of blocks: server letter -> block id
    var server_keys = [""; 128];
    var block_ids = [""; 128];
    var block_count = 0;
    var i = 1;
    while i < lines.length && lines[i].trim().length() > 0 {
        let line = lines[i].trim();
        let parts_of_line = (line as JStr).split("=", 2);
        if parts_of_line.length == 2 && parts_of_line[0].length() > 0 && block_count < 128 {
            server_keys[block_count] = parts_of_line[0].substring(0, 1);
            block_ids[block_count] = parts_of_line[1];
            block_count = block_count + 1;
        }
        i = i + 1;
    }
    while i < lines.length && lines[i].trim().length() == 0 {
        i = i + 1;
    }

    let encoded_builder = JStringBuilder::new();
    while i < lines.length {
        encoded_builder.append(lines[i].trim());
        i = i + 1;
    }
    let encoded = encoded_builder.toString();
    if encoded.length() < slices * rows * chars || slices * rows * chars <= 0 {
        return data;
    }

    var has_controller = false;
    var e = 0;
    while e < encoded.length() && !has_controller {
        if encoded.substring(e, e + 1) == "=" { has_controller = true; }
        e = e + 1;
    }

    var alphabet = LETTERS_LOWER_FIRST;
    if uppercase_first {
        alphabet = LETTERS_UPPER_FIRST;
    }

    // Decide, for every block in the table, what it is written as. Blocks that are written the same way share one letter.
    var entry_keys = [""; 128];
    var entry_preds = [""; 128];
    var entry_notes = [""; 128];
    var entry_letters = [""; 128];
    var entry_count = 0;
    var next_letter = 0;

    var translate_from = "";
    var translate_to = "";

    var b = 0;
    while b < block_count {
        let id = block_ids[b];
        var key = "";
        var pred = "";
        var note = "";
        var spaced = false;

        if is_air(id) && air_mode == 0 {
            spaced = true;
        } else if is_air(id) && air_mode == 1 {
            key = "air";
            pred = "Predicates.air()";
        } else {
            var abilities = "";
            if parts {
                abilities = part_abilities(id);
            }
            if abilities != "" {
                key = "abilities:" + abilities;
                pred = abilities_predicate(abilities);
                note = id;
            } else {
                key = "block:" + id;
                pred = "Predicates.blocks(\"" + js_escape(id) + "\")";
            }
        }

        var letter = " ";
        if !spaced {
            var found = index_of_key(&entry_keys, entry_count, key);
            if found < 0 {
                // the next letter that is not the controller's
                var candidate = alphabet.substring(next_letter, next_letter + 1);
                next_letter = next_letter + 1;
                if has_controller && candidate == CONTROLLER_LETTER {
                    candidate = alphabet.substring(next_letter, next_letter + 1);
                    next_letter = next_letter + 1;
                }
                entry_keys[entry_count] = key;
                entry_preds[entry_count] = pred;
                entry_notes[entry_count] = note;
                entry_letters[entry_count] = candidate;
                found = entry_count;
                entry_count = entry_count + 1;
            }
            letter = entry_letters[found];
        }
        translate_from = translate_from + server_keys[b];
        translate_to = translate_to + letter;
        b = b + 1;
    }

    // The slices: `slices` of `rows` rows of `chars` characters each.
    let slice_lines = JStringBuilder::new();
    let indent = "    ";
    var s = 0;
    while s < slices {
        if full {
            slice_lines.append(indent);
        }
        slice_lines.append(".slice(");
        var r = 0;
        while r < rows {
            if r > 0 {
                slice_lines.append(", ");
            }
            slice_lines.append("\"");
            var c = 0;
            while c < chars {
                let cell = encoded.substring((s * rows + r) * chars + c, (s * rows + r) * chars + c + 1);
                if cell == "=" {
                    slice_lines.append(CONTROLLER_LETTER);
                } else {
                    let at = translate_from.indexOf(cell);
                    if at >= 0 {
                        slice_lines.append(js_escape(translate_to.substring(at, at + 1)));
                    } else {
                        slice_lines.append("?");
                    }
                }
                c = c + 1;
            }
            slice_lines.append("\"");
            r = r + 1;
        }
        slice_lines.append(")\n");
        s = s + 1;
    }

    // The predicates.
    let where_lines = JStringBuilder::new();
    var pad = "";
    if full {
        pad = indent;
    }
    if has_controller {
        where_lines.append(pad);
        where_lines.append(".where(\"" + CONTROLLER_LETTER + "\", Predicates.controller(Predicates.blocks(definition.get())))\n");
    }
    var p = 0;
    while p < entry_count {
        where_lines.append(pad);
        where_lines.append(".where(\"" + js_escape(entry_letters[p]) + "\", " + entry_preds[p] + ")");
        if entry_notes[p] != "" {
            where_lines.append(" // " + entry_notes[p]);
        }
        where_lines.append("\n");
        p = p + 1;
    }

    let output = JStringBuilder::new();
    if full {
        output.append(".pattern(definition => FactoryBlockPattern.start()\n");
        output.append(slice_lines.toString());
        output.append(where_lines.toString());
        output.append(indent);
        output.append(".build())\n");
        if !has_controller {
            output.append("// no controller was marked: add one with .where(\"K\", Predicates.controller(Predicates.blocks(definition.get()))) and a K in a slice\n");
        }
    } else {
        output.append(slice_lines.toString());
        output.append("\n");
        output.append(where_lines.toString());
    }
    return output.toString();
}

// The default style: lowercase letters first, air as a space, hatches as abilities, just the slice and where lines.
pub fn decode_clipboard(data: String) -> String {
    return decode_clipboard_with(data, false, 0, true, false);
}

// Client side: decode with the player's settings, then either copy the text or (when it is too long for the clipboard) save it to
// packet.txt and copy that path.
pub fn set_clipboard(data: String) {
    let text = decode_clipboard_with(data, ClientConfig::uppercaseFirst(), ClientConfig::airMode(), ClientConfig::partsAsAbilities(), ClientConfig::fullPattern());
    let mc = Minecraft::getInstance();
    if text.length() > 32767 {
        try {
            let path = JPaths::get("packet.txt", [""; 0]);
            JFiles::writeString(path, text as JCharSequence, [
                JStandardOpenOption::CREATE as JOpenOption,
                JStandardOpenOption::TRUNCATE_EXISTING as JOpenOption,
                JStandardOpenOption::WRITE as JOpenOption
            ]);
            mc.keyboardHandler.setClipboard("Data saved to: " + path.toAbsolutePath().toString());
            let toast = SystemToast::new(
                SystemToastId::PERIODIC_NOTIFICATION,
                Component::literal("Copy Tool") as Component,
                Component::literal("The selection was too big for the clipboard; its file path was copied instead") as Component
            );
            mc.getToasts().addToast(toast as Toast);
        } catch (e: JException) {
            mc.keyboardHandler.setClipboard(text.substring(0, 32767));
        }
    } else {
        mc.keyboardHandler.setClipboard(text);
    }
}
